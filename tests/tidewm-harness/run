#!/bin/sh
# Stands in for tidewm in tidewm's tests/harness.py, so tidewm's suite runs
# against tidesway: TIDEWM=/path/to/tests/tidewm-harness/run.
#
# It's tide/tidesway.in, the command tidesway installs, which takes tidewm's
# arguments (-c CONFIG, -s STARTUP), run from this checkout: on the sway
# TIDESWAY names, or build/sway/sway here, where `meson setup build && ninja
# -C build` puts it, with this checkout's look.conf.
here=$(dirname -- "$(readlink -f -- "$0")")
root=${here%/tests/tidewm-harness}
TIDESWAY=${TIDESWAY:-$root/build/sway/sway} TIDESWAY_LOOK=${TIDESWAY_LOOK:-$root/tide/look.conf} \
    exec sh "$root/tide/tidesway.in" "$@"
