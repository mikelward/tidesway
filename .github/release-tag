#!/bin/sh
# Prints the tag the release workflow gives HEAD once it lands on main:
# v<sway's version>-tide.<commits since RELEASE_BASE>, both from meson.build.
# The version is padded to three parts, so sway's 1.12 tags as v1.12.0-tide.N.
# It needs the whole history (fetch-depth: 0) back to RELEASE_BASE.
set -eu
root=$(git rev-parse --show-toplevel)
version=$(sed -n "s/^[[:space:]]*version: '\([0-9.]*\)',\$/\1/p" "$root/meson.build" | head -n 1)
base=$(sed -n "s/^RELEASE_BASE = '\([0-9a-f]*\)'\$/\1/p" "$root/meson.build")
if test -z "$version" || test -z "$base"; then
	echo "release-tag: no version or RELEASE_BASE in meson.build" >&2
	exit 1
fi
if ! git merge-base --is-ancestor "$base" HEAD; then
	echo "release-tag: RELEASE_BASE $base isn't in HEAD's history" >&2
	exit 1
fi
case $version in
*.*.*) ;;
*) version=$version.0 ;;
esac
echo "v$version-tide.$(git rev-list --count "$base..HEAD")"
